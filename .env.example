# Copy this file to .env and fill in the values. .env is gitignored.
# Use a small throwaway repo, not a real project.
REPO_URL=https://github.com/WllowyEmmie/YOUR-TEST-REPO.git

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Exact model ID from openrouter.ai/models, e.g. deepseek/deepseek-chat
MODEL=deepseek/deepseek-chat
