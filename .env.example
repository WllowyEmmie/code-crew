# Copy this file to .env and fill in the values. .env is gitignored.
# Use a small throwaway repo, not a real project.
REPO_URL=https://github.com/WllowyEmmie/YOUR-TEST-REPO.git

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Exact model ID from openrouter.ai/models. It must support tool_choice, e.g. deepseek/deepseek-v4.1-flash-1017
MODEL=deepseek/deepseek-chat

# Publishing approved work: the harness pushes the crew's code-crew/<task> branch with your
# normal git login, then opens a pull request for you to review and merge.
# PUBLISH=false keeps everything local.
PUBLISH=true
# Optional: fine-grained GitHub token for this repo only, with repository permissions
# "Pull requests: Read and write" AND "Contents: Read-only" (needed to read the branches).
# Without it you get a link to open the pull request yourself.
GITHUB_TOKEN=

# Dreaming starts automatically after this many new work sessions (0 = only run it by hand).
DREAM_EVERY=100
# true = promote the dreamed memory without review (every promotion can still be rolled back).
DREAM_AUTO_PROMOTE=false

# Optional limits: steps per agent (default 100) and tokens per model reply (default 8000).
# CREW_MAX_STEPS=100
# CREW_MAX_TOKENS=8000
# If OpenRouter errors with no provider for tool_choice, set CREW_TOOL_CHOICE=auto (prose replies then fall back to repair/retry/nudge).
# CREW_TOOL_CHOICE=required
